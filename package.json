    "url": "https://github.com/DeedleMan/build-hw/issues"
  },
  "homepage": "https://github.com/DeedleMan/build-hw#readme",
  "description": "",
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.0",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
